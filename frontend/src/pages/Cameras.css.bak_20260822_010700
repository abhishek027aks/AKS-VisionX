.cameras-page {
  max-width: 1500px;
  margin: 0 auto;
}

.camera-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.camera-page-header h2 {
  margin: 0;
  color: #edf3fa;
  font-size: 21px;
}

.camera-page-header p {
  margin: 6px 0 0;
  color: #69788d;
  font-size: 12px;
}

.camera-refresh-button {
  padding: 9px 14px;
  border: 1px solid #263b54;
  border-radius: 8px;
  background: #0d1724;
  color: #b9c7d8;
  cursor: pointer;
}

.camera-refresh-button:disabled {
  opacity: .55;
  cursor: not-allowed;
}

.camera-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-bottom: 22px;
}

.camera-summary > div {
  padding: 18px;
  border: 1px solid #1b2a3c;
  border-radius: 12px;
  background: #0b121d;
}

.camera-summary span {
  display: block;
  color: #66758a;
  font-size: 11px;
}

.camera-summary strong {
  display: block;
  margin-top: 7px;
  color: #edf3fa;
  font-size: 25px;
}

.summary-online {
  color: #20d486 !important;
}

.camera-alert {
  margin-bottom: 18px;
  padding: 11px 14px;
  border-radius: 8px;
  font-size: 12px;
}

.camera-alert.success {
  border: 1px solid rgba(32, 212, 134, .25);
  background: rgba(32, 212, 134, .07);
  color: #53dc9c;
}

.camera-alert.error {
  border: 1px solid rgba(239, 82, 96, .25);
  background: rgba(239, 82, 96, .07);
  color: #ff8791;
}

.camera-grid-new {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.camera-card-new {
  overflow: hidden;
  border: 1px solid #1b2a3c;
  border-radius: 14px;
  background: #0b121c;
}

.camera-viewer-shell {
  position: relative;
}

.camera-preview-new {
  height: 230px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;

  background:
    linear-gradient(
      rgba(17, 29, 43, .88),
      rgba(5, 11, 18, .98)
    ),
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 20px,
      rgba(74, 101, 130, .06) 21px
    );

  color: #53677e;
  font-size: 9px;
  letter-spacing: 1.5px;
}

.camera-preview-new.view-fit
.camera-live-image {
  object-fit: contain;
}

.camera-preview-new.view-fill
.camera-live-image {
  object-fit: cover;
}

.camera-live-image {
  width: 100%;
  height: 100%;
  display: block;
  background: #050b12;
  transition: transform .18s ease;
  transform-origin: center center;
  user-select: none;
}

.camera-stream-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  height: 100%;
  width: 100%;
}

.camera-preview-icon {
  font-size: 31px;
  opacity: .55;
}

.camera-status {
  position: absolute;
  top: 11px;
  right: 11px;
  z-index: 5;

  display: flex;
  align-items: center;
  gap: 6px;

  padding: 6px 9px;
  border-radius: 7px;

  background: rgba(4, 9, 15, .86);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0;
}

.camera-status span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.camera-status.online {
  color: #20d486;
}

.camera-status.online span {
  background: #20d486;
  box-shadow: 0 0 8px rgba(32, 212, 134, .7);
}

.camera-status.offline {
  color: #ef6674;
}

.camera-status.offline span {
  background: #ef5260;
}

.viewer-toolbar {
  position: absolute;
  left: 8px;
  right: 8px;
  bottom: 8px;
  z-index: 8;

  display: flex;
  align-items: center;
  gap: 5px;
  flex-wrap: wrap;

  padding: 7px;

  border: 1px solid rgba(255,255,255,.08);
  border-radius: 9px;

  background: rgba(3, 8, 14, .88);
  backdrop-filter: blur(8px);
}

.viewer-toolbar button {
  min-width: 30px;
  height: 28px;
  padding: 0 8px;

  border: 1px solid #263448;
  border-radius: 6px;

  background: #111b29;
  color: #c8d4e2;

  font-size: 10px;
  cursor: pointer;
}

.viewer-toolbar button:hover {
  background: #192638;
}

.viewer-toolbar button.active {
  border-color: rgba(32, 212, 134, .4);
  background: rgba(32, 212, 134, .1);
  color: #20d486;
}

.zoom-value {
  min-width: 38px;
  color: #9eacbd;
  text-align: center;
  font-size: 9px;
}

.stream-retry-button {
  padding: 7px 12px;
  border: 1px solid rgba(32, 212, 134, .3);
  border-radius: 6px;
  background: rgba(32, 212, 134, .08);
  color: #20d486;
  cursor: pointer;
}

.ptz-panel {
  padding: 9px;
  border-top: 1px solid #172536;
  background: #09111b;
}

.ptz-title {
  margin-bottom: 7px;
  color: #60748b;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1px;
}

.ptz-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 5px;
  max-width: 190px;
  margin: 0 auto;
}

.ptz-grid button {
  height: 27px;

  border: 1px solid #223348;
  border-radius: 5px;

  background: #101b29;
  color: #aebdcd;

  font-size: 9px;
  cursor: pointer;
}

.ptz-grid button:hover {
  background: #18273a;
}

.ptz-grid .ptz-home {
  color: #20d486;
  border-color: rgba(32, 212, 134, .25);
}

.ptz-panel small {
  display: block;
  margin-top: 7px;
  color: #53667b;
  text-align: center;
  font-size: 7px;
  line-height: 1.4;
}

.camera-card-new:fullscreen {
  width: 100vw;
  height: 100vh;
  border: 0;
  border-radius: 0;
  background: #02060b;
}

.camera-card-new:fullscreen .camera-viewer-shell {
  width: 100%;
  height: 100%;
}

.camera-card-new:fullscreen .camera-preview-new {
  height: calc(100vh - 110px);
  min-height: 0;
}

.camera-card-new:fullscreen .camera-card-body {
  height: 110px;
}

.camera-card-new:fullscreen .ptz-panel {
  display: none;
}

.camera-card-new:fullscreen .camera-live-image {
  object-fit: contain;
}

.camera-card-body {
  padding: 17px;
}

.camera-name-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.camera-name-row h3 {
  margin: 0;
  color: #edf3fa;
  font-size: 14px;
}

.camera-name-row small {
  display: block;
  margin-top: 5px;
  color: #5f7085;
  font-size: 9px;
}

.running-state {
  padding: 5px 7px;
  border-radius: 5px;
  font-size: 8px;
  font-weight: 800;
}

.running-state.running {
  color: #20d486;
  background: rgba(32, 212, 134, .09);
}

.running-state.stopped {
  color: #ef7883;
  background: rgba(239, 82, 96, .09);
}

.camera-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;

  margin: 17px 0;
  padding: 13px 0;

  border-top: 1px solid #182434;
  border-bottom: 1px solid #182434;
}

.camera-meta span {
  display: block;
  margin-bottom: 5px;
  color: #607086;
  font-size: 9px;
}

.camera-meta strong {
  display: block;
  overflow: hidden;
  color: #b7c3d2;
  font-size: 10px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.camera-controls {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 7px;
}

.camera-controls button {
  padding: 9px 5px;
  border-radius: 7px;
  font-size: 10px;
  font-weight: 650;
  cursor: pointer;
}

.camera-controls button:disabled {
  opacity: .4;
  cursor: not-allowed;
}

.camera-start {
  border: 1px solid rgba(32, 212, 134, .3);
  background: rgba(32, 212, 134, .08);
  color: #20d486;
}

.camera-stop {
  border: 1px solid rgba(239, 82, 96, .3);
  background: rgba(239, 82, 96, .08);
  color: #ef7a85;
}

.camera-status-button {
  border: 1px solid #263448;
  background: #111b29;
  color: #b9c5d4;
}

.camera-empty {
  min-height: 350px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 8px;

  border: 1px dashed #263548;
  border-radius: 14px;

  color: #69788d;
  text-align: center;
}

.camera-empty-icon {
  color: #3f536b;
  font-size: 32px;
}

.camera-empty h3 {
  margin: 8px 0 0;
  color: #c4cfdd;
  font-size: 16px;
}

.camera-empty p {
  margin: 0;
  font-size: 11px;
}

@media (max-width: 1100px) {
  .camera-grid-new {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .camera-summary {
    grid-template-columns: 1fr;
  }

  .camera-grid-new {
    grid-template-columns: 1fr;
  }

  .camera-page-header {
    align-items: flex-start;
  }

  .viewer-toolbar {
    gap: 3px;
  }
}
