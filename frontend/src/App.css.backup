:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #e8edf5;
  background: #070b12;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at 80% 0%, rgba(20, 115, 255, 0.10), transparent 32rem),
    #070b12;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

#root {
  min-height: 100vh;
}

.login-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
}

.login-card {
  width: min(430px, 100%);
  padding: 38px;
  border: 1px solid #1d2a3b;
  border-radius: 20px;
  background: rgba(12, 18, 28, 0.96);
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
}

.brand-mark {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: linear-gradient(135deg, #1677ff, #00c2ff);
  color: white;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -1px;
  box-shadow: 0 10px 30px rgba(0, 150, 255, 0.25);
}

.brand-mark.small {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  font-size: 15px;
}

.login-card h1 {
  margin: 24px 0 8px;
  color: #fff;
  font-size: 31px;
  letter-spacing: -1px;
}

.subtitle {
  margin: 0 0 30px;
  color: #8391a5;
  line-height: 1.55;
}

.login-card label {
  display: block;
  margin: 17px 0 8px;
  color: #aeb9c8;
  font-size: 13px;
  font-weight: 650;
}

.login-card input {
  width: 100%;
  padding: 13px 14px;
  border: 1px solid #263448;
  border-radius: 10px;
  outline: none;
  background: #0a111c;
  color: white;
}

.login-card input:focus {
  border-color: #1685ff;
  box-shadow: 0 0 0 3px rgba(22, 133, 255, 0.12);
}

.primary-button {
  width: 100%;
  margin-top: 25px;
  padding: 13px;
  border: 0;
  border-radius: 10px;
  background: linear-gradient(135deg, #1478ff, #00a9ff);
  color: white;
  font-weight: 750;
}

.login-footer {
  margin-top: 25px;
  padding-top: 20px;
  border-top: 1px solid #1b2737;
  color: #657286;
  font-size: 12px;
  text-align: center;
}

.app-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.topbar {
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30px;
  border-bottom: 1px solid #182333;
  background: rgba(7, 11, 18, 0.92);
  backdrop-filter: blur(15px);
  position: sticky;
  top: 0;
  z-index: 20;
}

.topbar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-title {
  color: #fff;
  font-weight: 750;
  font-size: 15px;
}

.brand-subtitle {
  color: #68778c;
  font-size: 11px;
  margin-top: 2px;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.system-status {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #8e9aac;
  font-size: 12px;
}

.status-dot {
  width: 7px;
  height: 7px;
  display: inline-block;
  border-radius: 50%;
  background: #68778c;
}

.status-dot.online {
  background: #20d486;
  box-shadow: 0 0 10px rgba(32, 212, 134, 0.7);
}

.logout-button,
.refresh-button,
.status-button {
  border: 1px solid #263448;
  border-radius: 8px;
  padding: 8px 12px;
  color: #b9c5d4;
  background: #0d1521;
}

.logout-button:hover,
.refresh-button:hover,
.status-button:hover {
  border-color: #3d5470;
  color: #fff;
}

.dashboard {
  width: min(1450px, calc(100% - 48px));
  margin: 0 auto;
  padding: 38px 0 60px;
  flex: 1;
}

.dashboard-heading,
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.dashboard-heading h1 {
  margin: 0;
  color: #f7faff;
  font-size: 31px;
  letter-spacing: -1px;
}

.dashboard-heading p,
.section-header p {
  margin: 7px 0 0;
  color: #728095;
  font-size: 13px;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin: 28px 0 38px;
}

.stat-card {
  padding: 21px;
  border: 1px solid #1a2839;
  border-radius: 13px;
  background: #0c131e;
}

.stat-label {
  color: #728095;
  font-size: 12px;
  font-weight: 600;
}

.stat-value {
  margin-top: 8px;
  color: #f2f6fb;
  font-size: 27px;
  font-weight: 750;
}

.online-text {
  color: #20d486;
}

.system-ok {
  color: #4ea4ff;
}

.section-header {
  margin-bottom: 16px;
}

.section-header h2 {
  margin: 0;
  color: #eaf0f8;
  font-size: 18px;
}

.camera-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.camera-card {
  overflow: hidden;
  border: 1px solid #1b2a3c;
  border-radius: 14px;
  background: #0b121c;
}

.camera-preview {
  height: 190px;
  position: relative;
  display: grid;
  place-items: center;
  overflow: hidden;
  background:
    linear-gradient(rgba(20, 31, 45, 0.9), rgba(6, 11, 18, 0.96)),
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 20px,
      rgba(74, 101, 130, 0.06) 21px
    );
}

.camera-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  color: #52657c;
  font-size: 10px;
  letter-spacing: 1.5px;
}

.camera-icon {
  font-size: 34px;
  opacity: 0.65;
}

.live-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 6px 9px;
  border-radius: 7px;
  background: rgba(5, 10, 16, 0.8);
  color: #aeb9c8;
  font-size: 10px;
  font-weight: 750;
}

.live-badge.live {
  color: #20d486;
}

.live-badge.live .status-dot {
  background: #20d486;
}

.live-badge.offline .status-dot {
  background: #ef5260;
}

.camera-content {
  padding: 18px;
}

.camera-title-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.camera-title-row h3 {
  margin: 0;
  color: #eef3fa;
  font-size: 15px;
}

.camera-id {
  display: block;
  margin-top: 5px;
  color: #617085;
  font-size: 10px;
}

.running-badge {
  height: fit-content;
  padding: 5px 7px;
  border-radius: 5px;
  font-size: 9px;
  font-weight: 800;
}

.running-badge.running {
  background: rgba(32, 212, 134, 0.10);
  color: #20d486;
}

.running-badge.stopped {
  background: rgba(239, 82, 96, 0.09);
  color: #ef7a85;
}

.camera-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin: 18px 0;
  padding: 13px 0;
  border-top: 1px solid #182434;
  border-bottom: 1px solid #182434;
}

.camera-details span {
  display: block;
  margin-bottom: 5px;
  color: #607086;
  font-size: 10px;
}

.camera-details strong {
  display: block;
  overflow: hidden;
  color: #b6c1d0;
  font-size: 11px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.camera-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 7px;
}

.camera-actions button {
  padding: 9px 5px;
  border-radius: 7px;
  font-size: 11px;
  font-weight: 650;
}

.start-button {
  border: 1px solid rgba(32, 212, 134, 0.3);
  background: rgba(32, 212, 134, 0.08);
  color: #20d486;
}

.stop-button {
  border: 1px solid rgba(239, 82, 96, 0.3);
  background: rgba(239, 82, 96, 0.08);
  color: #ef7a85;
}

.status-button {
  background: #111b29;
}

.alert {
  margin: 18px 0;
  padding: 11px 14px;
  border-radius: 8px;
  font-size: 12px;
}

.alert.success {
  border: 1px solid rgba(32, 212, 134, 0.25);
  background: rgba(32, 212, 134, 0.07);
  color: #53dc9c;
}

.alert.error {
  border: 1px solid rgba(239, 82, 96, 0.25);
  background: rgba(239, 82, 96, 0.07);
  color: #ff8791;
}

.empty-state {
  padding: 70px 20px;
  border: 1px dashed #263548;
  border-radius: 14px;
  text-align: center;
}

.empty-icon {
  color: #3f536b;
  font-size: 35px;
}

.empty-state h3 {
  color: #c4cfdd;
  margin: 14px 0 6px;
}

.empty-state p {
  color: #69788d;
  font-size: 12px;
}

.footer {
  display: flex;
  justify-content: space-between;
  padding: 18px 30px;
  border-top: 1px solid #182333;
  color: #536277;
  font-size: 10px;
}

@media (max-width: 1050px) {
  .camera-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .topbar {
    padding: 0 16px;
  }

  .system-status {
    display: none;
  }

  .dashboard {
    width: min(100% - 28px, 1450px);
    padding-top: 25px;
  }

  .camera-grid {
    grid-template-columns: 1fr;
  }

  .stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .dashboard-heading h1 {
    font-size: 24px;
  }

  .footer {
    padding: 16px;
  }
}

@media (max-width: 450px) {
  .login-card {
    padding: 26px;
  }

  .topbar {
    height: 64px;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .footer span:last-child {
    display: none;
  }
}
