class CameraViewSet(viewsets.ModelViewSet):
    serializer_class = CameraSerializer

    def get_queryset(self):
        queryset = (
            Camera.objects
            .select_related("organization", "created_by")
            .prefetch_related("streams")
            .all()
        )

        return organization_queryset(
            queryset,
            self.request.user,
        )

    def get_permissions(self):
        if self.action in ["list", "retrieve"]:
            permission_classes = [
                IsViewerOrAbove,
            ]

        elif self.action in ["create", "partial_update", "update"]:
            permission_classes = [
                IsOperatorOrAbove,
            ]

        elif self.action == "destroy":
            permission_classes = [
                IsAdminOrSuperAdmin,
            ]

        else:
            permission_classes = [
                IsAuthenticated,
            ]

        return [
            permission()
            for permission in permission_classes
        ]
class CameraStreamViewSet(viewsets.ModelViewSet):
    serializer_class = CameraStreamSerializer

    def get_queryset(self):
        queryset = (
            CameraStream.objects
            .select_related("camera", "camera__organization")
            .all()
        )

        return queryset.filter(
            camera__organization_id=self.request.user.organization_id
        ) if not self.request.user.groups.filter(
            name="Super Admin"
        ).exists() else queryset

    def get_permissions(self):
        if self.action in ["list", "retrieve"]:
            permission_classes = [
                IsViewerOrAbove,
            ]

        elif self.action in ["create", "partial_update", "update"]:
            permission_classes = [
                IsOperatorOrAbove,
            ]

        elif self.action == "destroy":
            permission_classes = [
                IsAdminOrSuperAdmin,
            ]

        else:
            permission_classes = [
                IsAuthenticated,
            ]

        return [
            permission()
            for permission in permission_classes
        ]

