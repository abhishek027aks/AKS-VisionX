User = get_user_model()


class CurrentUserSerializer(serializers.ModelSerializer):
    roles = serializers.SerializerMethodField()

    class Meta:
        model = User
        fields = [
            "id",
            "username",
            "email",
            "first_name",
            "last_name",
            "is_staff",
            "is_superuser",
            "is_active",
            "organization",
            "roles",
        ]
        read_only_fields = fields

    def get_roles(self, obj):
        return list(
            obj.groups.values_list("name", flat=True).order_by("name")
        )


class CameraStreamSerializer(serializers.ModelSerializer):
    camera = serializers.PrimaryKeyRelatedField(
        queryset=Camera.objects.all(),
    )

    class Meta:
        model = CameraStream
        fields = [
            "id",
            "camera",
            "name",
            "stream_type",
            "protocol",
            "url",
            "width",
            "height",
            "fps",
            "codec",
            "bitrate_kbps",
            "enabled",
            "created_at",
            "updated_at",
        ]
        read_only_fields = [
            "id",
            "created_at",
            "updated_at",
        ]

    def validate_camera(self, camera):
        request = self.context.get("request")
        user = request.user

        if user.groups.filter(name="Super Admin").exists():
            return camera

        if not user.organization_id:
            raise serializers.ValidationError(
                "User is not assigned to an organization."
            )

        if camera.organization_id != user.organization_id:
            raise serializers.ValidationError(
                "You cannot access a camera from another organization."
            )

        return camera


class CameraSerializer(serializers.ModelSerializer):
    streams = CameraStreamSerializer(many=True, read_only=True)

    credential_encrypted = serializers.CharField(
        write_only=True,
        required=False,
        allow_blank=True,
    )

    organization = serializers.PrimaryKeyRelatedField(
        read_only=True,
    )

    created_by = serializers.PrimaryKeyRelatedField(
        read_only=True,
    )

    class Meta:
        model = Camera
        fields = [
            "id",
            "organization",
            "created_by",
            "name",
            "manufacturer",
            "model",
            "serial_number",
            "connection_type",
            "host",
            "port",
            "username",
            "credential_encrypted",
            "onvif_supported",
            "rtsp_supported",
            "ptz_supported",
            "audio_supported",
            "ai_supported",
            "enabled",
            "status",
            "last_seen",
            "streams",
            "created_at",
            "updated_at",
        ]
        read_only_fields = [
            "id",
            "organization",
            "created_by",
            "status",
            "last_seen",
            "streams",
            "created_at",
            "updated_at",
        ]

    def create(self, validated_data):
        credential = validated_data.pop(
            "credential_encrypted",
            "",
        )

        request = self.context["request"]
        user = request.user

        camera = Camera(
            organization=user.organization,
            created_by=user,
            **validated_data,
        )

        if credential:
            camera.set_credential(credential)

        camera.save()

        return camera

    def update(self, instance, validated_data):
        credential = validated_data.pop(
            "credential_encrypted",
            None,
        )

        for attr, value in validated_data.items():
            setattr(instance, attr, value)

        if credential is not None:
            instance.set_credential(credential)

        instance.save()

        return instance


