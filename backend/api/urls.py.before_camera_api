from django.urls import path
from rest_framework_simplejwt.views import (
    TokenObtainPairView,
    TokenRefreshView,
)

from .views import (
    admin_test,
    current_user,
    health_check,
    operator_test,
    super_admin_test,
    viewer_test,
)


urlpatterns = [
    path("health/", health_check, name="api-health"),

    path(
        "auth/token/",
        TokenObtainPairView.as_view(),
        name="token-obtain-pair",
    ),

    path(
        "auth/token/refresh/",
        TokenRefreshView.as_view(),
        name="token-refresh",
    ),

    path(
        "me/",
        current_user,
        name="current-user",
    ),

    path(
        "rbac/viewer-test/",
        viewer_test,
        name="rbac-viewer-test",
    ),

    path(
        "rbac/operator-test/",
        operator_test,
        name="rbac-operator-test",
    ),

    path(
        "rbac/admin-test/",
        admin_test,
        name="rbac-admin-test",
    ),

    path(
        "rbac/super-admin-test/",
        super_admin_test,
        name="rbac-super-admin-test",
    ),
]
