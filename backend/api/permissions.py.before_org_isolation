from rest_framework.permissions import BasePermission


ROLE_SUPER_ADMIN = "Super Admin"
ROLE_ADMIN = "Admin"
ROLE_OPERATOR = "Operator"
ROLE_VIEWER = "Viewer"


def has_role(user, role):
    if not user or not user.is_authenticated:
        return False

    return user.groups.filter(name=role).exists()


def has_any_role(user, roles):
    if not user or not user.is_authenticated:
        return False

    return user.groups.filter(name__in=roles).exists()


class IsSuperAdmin(BasePermission):
    message = "Super Admin permission required."

    def has_permission(self, request, view):
        return has_role(request.user, ROLE_SUPER_ADMIN)


class IsAdminOrSuperAdmin(BasePermission):
    message = "Admin or Super Admin permission required."

    def has_permission(self, request, view):
        return has_any_role(
            request.user,
            [
                ROLE_SUPER_ADMIN,
                ROLE_ADMIN,
            ],
        )


class IsOperatorOrAbove(BasePermission):
    message = "Operator, Admin, or Super Admin permission required."

    def has_permission(self, request, view):
        return has_any_role(
            request.user,
            [
                ROLE_SUPER_ADMIN,
                ROLE_ADMIN,
                ROLE_OPERATOR,
            ],
        )


class IsViewerOrAbove(BasePermission):
    message = "Authenticated VisionX role required."

    def has_permission(self, request, view):
        return has_any_role(
            request.user,
            [
                ROLE_SUPER_ADMIN,
                ROLE_ADMIN,
                ROLE_OPERATOR,
                ROLE_VIEWER,
            ],
        )
